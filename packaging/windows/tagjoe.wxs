<?xml version="1.0" encoding="utf-8"?>
<!--
  tagjoe as an MSI (WiX 3.14), after tvjoe/packaging/windows/tvjoe.wxs. Built by tools/build-windows.ps1;
  the file list (component group "AppFiles") is generated by the script from the staging folder.

  - Per-user installation without administrator rights into %LOCALAPPDATA%\Programs\tagjoe
    (programs in bin\, licence texts next to them).
  - Start menu shortcut, entry in "Apps & features"; uninstalling removes only the program folder.
    Settings (%APPDATA%\tagjoe) and cache (%LOCALAPPDATA%\tagjoe) stay untouched.
  - The UpgradeCode is fixed and must never change: every new MSI replaces the old one (MajorUpgrade).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="tagjoe" Language="1031" Codepage="1252" Version="$(var.Version)" Manufacturer="John Lose (joeMJ)"
           UpgradeCode="E303501E-C69C-45D8-AA28-C189E745C440">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64"
             Languages="1031" SummaryCodepage="1252" Description="tagjoe $(var.Version)"
             Comments="Tags, Cover und Dateinamen für Alben, Sampler und Hörbücher" />

    <!-- Installing the same version again replaces it as well (rebuilt MSI). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Eine neuere Version von tagjoe ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="TagjoeIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="TagjoeIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/joeMJ/tagjoe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/joeMJ/tagjoe" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="tagjoe" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="7C1C2E4A-0E6B-4B55-9C1F-2D8A5B6E3F10">
        <!-- Icon from tagjoe-gui.exe (fixed place), not from the MSI's icon cache (changes with every update;
             pinned taskbar entries showed an empty icon otherwise). -->
        <Shortcut Id="AppShortcut" Name="tagjoe" Description="Tags, Cover und Dateinamen für Alben, Sampler und Hörbücher"
                  Target="[INSTALLDIR]bin\tagjoe-gui.exe" WorkingDirectory="INSTALLDIR" />
        <!-- Remove "Programs" only when it is empty afterwards (Windows Installer checks that). -->
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\tagjoe\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Ask a running tagjoe to close before the files are replaced (otherwise Windows Installer waits for them):
         first politely; if it still runs, a message asks (Retry/Cancel). -->
    <util:CloseApplication Id="CloseTagjoeGui" Target="tagjoe-gui.exe" Sequence="1" CloseMessage="yes" PromptToContinue="yes" RebootPrompt="no"
                           Description="tagjoe läuft noch und muss für die Installation beendet werden. Bitte tagjoe schließen und dann „Wiederholen“ wählen." />
    <util:CloseApplication Id="CloseTagjoe" Target="tagjoe.exe" Sequence="2" TerminateProcess="0" RebootPrompt="no" />

    <Feature Id="Main" Title="tagjoe" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
