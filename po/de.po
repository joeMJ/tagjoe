msgstr ""
"Jede betroffene Datei erscheint vor dem Schreiben in der Dateiliste; dort "
"einzelne Haken entfernen, um Dateien zu behalten."

#: crates/tagjoe-gui/src/settings.rs:379
msgid "ID3"
msgstr "ID3"

#: crates/tagjoe-gui/src/settings.rs:380
msgid "ID3v2.4 (UTF-8, standard)"
msgstr "ID3v2.4 (UTF-8, Standard)"

#: crates/tagjoe-gui/src/settings.rs:381
