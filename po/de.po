#: crates/tagjoe-gui/src/settings.rs:365
msgid "Remove ID3v1 and APE containers from MP3 files (ID3v2 stays)"
msgstr "ID3v1- und APE-Container aus MP3-Dateien entfernen (ID3v2 bleibt)"

#: crates/tagjoe-gui/src/settings.rs:365
msgid "SECONDARY CONTAINERS"
msgstr "ZWEITCONTAINER"

#: crates/tagjoe-gui/src/settings.rs:366
msgid "FOLDER FILES"
msgstr "DATEIEN IM ORDNER"

#: crates/tagjoe-gui/src/settings.rs:367
msgid ""
"Apply and Clean delete these files from the folder (after every audio file "
"was written without error; the folder cover is embedded first; deleted for "
"good)"
msgstr ""
"„Übernehmen“ und „Bereinigen“ löschen diese Dateien aus dem Ordner (erst "
"nachdem alle Audiodateien fehlerfrei geschrieben wurden; das Ordner-Cover "
"wird zuvor eingebettet; endgültig, ohne Rückgängig)"

#: crates/tagjoe-gui/src/settings.rs:371
msgid "Images (JPG, JPEG, PNG)"
msgstr "Bilder (JPG, JPEG, PNG)"

#: crates/tagjoe-gui/src/settings.rs:374
msgid "Further extensions (comma-separated)"
msgstr "Weitere Endungen (durch Komma getrennt)"

#: crates/tagjoe-gui/src/settings.rs:375
msgid ""
