msgstr "ID3v2.3 (ältere Windows-Programme)"

#: crates/tagjoe-gui/src/settings.rs:383
msgid "COVER"
msgstr "COVER"

#: crates/tagjoe-gui/src/settings.rs:384
msgid ""
